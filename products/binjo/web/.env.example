# Database (Supabase)
# Pooler connection (port 6543) — used at runtime
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true
# Direct connection (port 5432) — used for migrations
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Admin auth
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-secure-password-here
# Enable only when every request reaches Next.js through a trusted reverse proxy
# that overwrites/appends X-Forwarded-For (the Vultr Caddy stack does this).
ADMIN_LOGIN_TRUST_PROXY=false
# Farmer UUID whose operational data the single-farm admin manages.
ADMIN_FARMER_ID=00000000-0000-0000-0000-000000000000
JWT_SECRET=your-random-jwt-secret-here

# Image storage. Local is the default for this single-server deployment.
# Relative LOCAL_UPLOAD_DIR values resolve from the web app working directory.
IMAGE_STORAGE_PROVIDER=local
LOCAL_UPLOAD_DIR=.data/uploads

# Only required when IMAGE_STORAGE_PROVIDER=supabase.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# FastAPI URLs
# Browser-visible production API URL
NEXT_PUBLIC_API_URL=/backend
# Server-side Next.js rewrite target (use http://api:8000 in Docker Compose)
API_INTERNAL_URL=http://localhost:8002

# Farmer feature visibility. Public builds must not advertise integrations that
# are not configured in the API environment.
NEXT_PUBLIC_ENABLE_TEST_LOGIN=false
NEXT_PUBLIC_ENABLE_KAKAO_LOGIN=false
NEXT_PUBLIC_ENABLE_VOICE=false
NEXT_PUBLIC_ENABLE_PHOTO_UPLOAD=false

# Launch-safety gates. Keep both the private runtime gate and matching public
# build flag false until the external dependency passes an end-to-end check.
ENABLE_DIRECT_CHECKOUT=false
NEXT_PUBLIC_ENABLE_DIRECT_CHECKOUT=false
NEXT_PUBLIC_TOSS_CLIENT_KEY=

ENABLE_RECEIPT_OCR=false
NEXT_PUBLIC_ENABLE_RECEIPT_OCR=false
